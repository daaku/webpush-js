{
  "compilerOptions": {
    "declaration": true,
    "erasableSyntaxOnly": true,
    "lib": [
      "esnext",
      "dom"
    ],
    "module": "nodenext",
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "esnext",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "test",
    "example"
  ]
}
